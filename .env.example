# Copy to .env, or let scripts/provision.sh write it (it keeps ANTHROPIC_API_KEY and SESSION_SECRET).
# GK_USER_*: your three existing test users (provision.sh --alice/--bob/--carol writes them here).
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=
ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback
GK_USER_ALICE=support-agent@<your-tenant>.onmicrosoft.com
GK_USER_BOB=finance-analyst@<your-tenant>.onmicrosoft.com
GK_USER_CAROL=tenant-admin@<your-tenant>.onmicrosoft.com
ANTHROPIC_API_KEY=
SESSION_SECRET=
